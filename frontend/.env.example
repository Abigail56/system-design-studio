# --- Clerk (frontend) -------------------------------------------------------
# From Clerk Dashboard -> API Keys. Required for sign-in to work.
# Both NEXT_PUBLIC_* because `browserFetch` runs in the browser, not just on
# the server. See README for the dev auth bypass if you have no keys yet.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# --- Backend ----------------------------------------------------------------
# FastAPI service in ../api. `NEXT_PUBLIC_` because client components call it
# directly; browser requests are restricted by the API's CORS allowlist.
# Use the internal URL in production so Server Components skip the public hop.
NEXT_PUBLIC_GHOST_API_URL="http://localhost:8000"

# --- Dev auth bypass (local only) ------------------------------------------
# Bypasses Clerk with a fake local identity so the app can be explored without
# a Clerk account. The API refuses to honour it when ENVIRONMENT=production.
# DEV_AUTH="true"
# DEV_AUTH_EMAIL="you@example.com"

# --- Liveblocks (Milestone 2) -----------------------------------------------
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY="pk_..."
LIVEBLOCKS_SECRET_KEY="sk_..."