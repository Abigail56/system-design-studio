# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://user:password@host:5432/ghost"

# --- Clerk -------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2FwYWJsZS1rcmlsbC02NDUwLmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY="sk_test_..."
# From Clerk Dashboard -> API Keys -> Show API keys. Optional: defaults to the
# shared Clerk JWKS endpoint.
CLERK_JWKS_URL=""
CLERK_API_BASE="https://api.clerk.com/v1"
# From Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret
CLERK_WEBHOOK_SECRET="whsec_..."

# --- Liveblocks (Milestone 2) -----------------------------------------------
LIVEBLOCKS_SECRET_KEY="sk_..."

# --- Trigger.dev worker (Milestone 4) ---------------------------------------
# Read by the TS worker in ghost/trigger/, not by this service.
TRIGGERDEV_URL="https://api.trigger.dev"

# --- Vercel Blob (Milestone 3) ----------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Web --------------------------------------------------------------------
# Comma-separated. Add your Vercel production URL when you deploy.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
ENVIRONMENT="development"
FRONTEND_URL="http://localhost:3000"

# --- Email invitations (Resend) --------------------------------------------
# Create an API key in Resend and use a verified sender address/domain.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- AI provider ------------------------------------------------------------
# Set one provider key. OpenRouter is preferred if multiple keys are configured.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Used by OpenRouter for app identification; update when deploying.
OPENROUTER_HTTP_REFERER="http://localhost:3000"
# Alternatively, use a direct provider:
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"
